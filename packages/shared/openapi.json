  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Action Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "compare_prices",
              "find_reviews",
              "open_url",
              "read_article",
              "custom"
            ],
            "title": "Type"
          },
          "label": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Label"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "requires_approval": {
            "type": "boolean",
            "const": true,
            "title": "Requires Approval",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_id",
          "type",
          "label",
          "description",
          "expires_at"
        ],
        "title": "Action"
      },
      "ActionResult": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "maxLength": 16000,
            "title": "Message"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "message"
        ],
        "title": "ActionResult"
      },
      "ActionsSubmission": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "request_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Request Id"
          },
          "page_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Page Id"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
