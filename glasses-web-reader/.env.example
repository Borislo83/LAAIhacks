# Required for the reader's AI-built web layouts and recommended actions.
ANTHROPIC_API_KEY=
# Existing LAAIhacks orchestrator (owns Supabase persistence and task prediction).
ORCHESTRATOR_URL=http://127.0.0.1:8001
# Add the exact HTTPS origin when accessing the reader through a tunnel or host.
# ORCHESTRATOR_ALLOWED_ORIGINS=https://your-reader.example.com
# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5   # or claude-sonnet-5-5 / claude-opus-5-5 for better screens at higher cost
# CLAUDE_RECOMMENDATIONS_MODEL=claude-opus-5-5   # defaults to CLAUDE_MODEL
# PORT=8787
# CORS_ORIGIN=*
# ALLOW_PRIVATE_HOSTS=1   # allow fetching localhost/LAN URLs (dev only)
# Voice search: speech-to-text for clips from the glasses mic (StepFun preferred, else OpenAI)
# STEPFUN_API_KEY=               # platform.stepfun.ai "Normal" key; default model stepaudio-2.5-asr
# OPENAI_API_KEY=                # default model gpt-4o-mini-transcribe
# STT_MODEL=
# VOICE_SAVE_DIR=./voice-clips   # keep each clip as .wav (debugging)
# Hands-free wake phrase is "Hey <WAKE_NAME>" (src/main.ts WAKE_PHRASE must match; default "Hey Focal")
# WAKE_NAME=focal
# WAKE_ALIASES=vocal,fokal   # mishearings that also count
# STT_LANGUAGE=en
