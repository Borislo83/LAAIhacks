{
  "package_id": "com.example.glasseswebreader",
  "edition": "202601",
  "name": "Web Reader",
  "version": "0.1.0",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Sends the page URL you enter to the condense server, which fetches and condenses it for the glasses.",
      "whitelist": [
        "https://your-condense-server.example.com"
      ]
    }
  ],
  "supported_languages": [
    "en"
  ]
}