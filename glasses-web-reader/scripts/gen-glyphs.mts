// Generates src/glyph-atlas.ts: the G2 font and rounded border corners as the simulator
// draws them, so the phone's live mirror renders pixel for pixel like the lens. The font
// is compiled into the firmware (no font file to load), so both are photographed off the
// simulator.
// Needs the dev server up (npm run dev). Run: npx tsx scripts/gen-glyphs.mts
import sharp from 'sharp'
import { spawn } from 'node:child_process'
import { writeFileSync } from 'node:fs'
import { CORNER_BORDERS, CORNER_RADII, LINE_H, MARGIN, cornerSheets, cornerSize, sheets } from './glyph-sheet'

const PORT = 9897
const API = `http://127.0.0.1:${PORT}/api`
const url = `http://localhost:${process.env.VITE_PORT ?? 5173}/scripts/glyph-sheet.html`
const wait = (ms: number) => new Promise(r => setTimeout(r, ms))

/** Opens the sheet page with `query` in a fresh simulator; returns the display's coverage. */
async function shoot(query: string) {
  // Its own process group, so the simulator npx starts goes down with it.
  const sim = spawn('npx', ['evenhub-simulator', '--automation-port', String(PORT), '--no-glow', `${url}?${query}`],
    { stdio: 'ignore', detached: true })
  try {
    for (let i = 0; ; i++) {
      if (await fetch(`${API}/ping`).then(r => r.ok, () => false)) break
      if (i > 60) throw new Error('simulator did not start')
      await wait(500)
    }
    await wait(4000)
    const png = Buffer.from(await (await fetch(`${API}/screenshot/glasses`)).arrayBuffer())
    const { data, info } = await sharp(png).ensureAlpha().extractChannel(3).raw().toBuffer({ resolveWithObject: true })
    return (x: number, y: number) => (x >= 0 && x < info.width && y >= 0 && y < info.height ? data[y * info.width + x] : 0)
  } finally {
    try { process.kill(-sim.pid!) } catch { /* already gone */ }
    await wait(1000)
  }
}

{
  const cells: { ch: string; alpha: Buffer; w: number }[] = []
  for (const [n, sheet] of sheets().entries()) {
    const at = await shoot(`sheet=${n}`)
    for (const c of sheet.cells) {
      const x0 = c.x - MARGIN
      const w = c.adv + 2 * MARGIN
      const alpha = Buffer.alloc(w * LINE_H)
      for (let y = 0; y < LINE_H; y++) {
        for (let x = 0; x < w; x++) alpha[y * w + x] = at(x0 + x, c.y + y)
      }
      // Ink on the cell's outer edge means the pen positions drifted from the firmware's.
      for (let y = 0; y < LINE_H; y++) {
        if (alpha[y * w] || alpha[y * w + w - 1]) console.warn(`ink at the edge of ${JSON.stringify(c.ch)}`)
      }
      cells.push({ ch: c.ch, alpha, w })
    }
  }

  // One row of cells, as white with the glyph's coverage in alpha.
  const width = cells.reduce((n, c) => n + c.w, 0)
  const rgba = Buffer.alloc(width * LINE_H * 4)
  const index: Record<string, [number, number]> = {}
  let x = 0
  for (const c of cells) {
    index[c.ch] = [x, c.w]
    for (let y = 0; y < LINE_H; y++) {
      for (let i = 0; i < c.w; i++) {
        const o = (y * width + x + i) * 4
        rgba.fill(255, o, o + 3)
        rgba[o + 3] = c.alpha[y * c.w + i]
      }
    }
    x += c.w
  }
  const png = await sharp(rgba, { raw: { width, height: LINE_H, channels: 4 } }).png({ compressionLevel: 9 }).toBuffer()

  // Top-left corners of bordered boxes, in a row; the other three corners are mirror images.
  const corners: { key: string; alpha: Buffer; k: number }[] = []
  for (const [n, boxes] of cornerSheets().entries()) {
    const at = await shoot(`corners=${n}`)
    for (const b of boxes) {
      const k = cornerSize(b.r, b.b)
      const alpha = Buffer.alloc(k * k)
      for (let y = 0; y < k; y++) {
        for (let x = 0; x < k; x++) {
          alpha[y * k + x] = at(b.x + x, b.y + y)
          const mirrored = [at(b.x + b.w - 1 - x, b.y + y), at(b.x + x, b.y + b.h - 1 - y), at(b.x + b.w - 1 - x, b.y + b.h - 1 - y)]
          if (mirrored.some(v => Math.abs(v - alpha[y * k + x]) > 2)) console.warn(`corner r=${b.r} b=${b.b} isn't symmetric`)
        }
      }
      corners.push({ key: `${b.r},${b.b}`, alpha, k })
    }
  }
  const cornerW = corners.reduce((n, c) => n + c.k, 0)
  const cornerH = Math.max(...corners.map(c => c.k))
  const cornerRgba = Buffer.alloc(cornerW * cornerH * 4)
  const cornerIndex: Record<string, [number, number]> = {}
  x = 0
  for (const c of corners) {
    cornerIndex[c.key] = [x, c.k]
    for (let y = 0; y < c.k; y++) {
      for (let i = 0; i < c.k; i++) {
        const o = (y * cornerW + x + i) * 4
        cornerRgba.fill(255, o, o + 3)
        cornerRgba[o + 3] = c.alpha[y * c.k + i]
      }
    }
    x += c.k
  }
  const cornerPng = await sharp(cornerRgba, { raw: { width: cornerW, height: cornerH, channels: 4 } }).png({ compressionLevel: 9 }).toBuffer()
  writeFileSync(new URL('../src/glyph-atlas.ts', import.meta.url), `// Generated by scripts/gen-glyphs.mts. Do not edit.
/** Each glyph's cell in the atlas: [x, width]; cells are LINE_H tall and start MARGIN px before the pen. */
export const GLYPH_CELLS: Record<string, [number, number]> = ${JSON.stringify(index)}
export const GLYPH_LINE_H = ${LINE_H}
export const GLYPH_MARGIN = ${MARGIN}
export const GLYPH_ATLAS = 'data:image/png;base64,${png.toString('base64')}'

/** A box's top-left corner by "radius,border" (radius ${CORNER_RADII[0]}-${CORNER_RADII.at(-1)}, border ${CORNER_BORDERS.join('/')}): [x, size] in the corner atlas. */
export const CORNER_CELLS: Record<string, [number, number]> = ${JSON.stringify(cornerIndex)}
export const CORNER_ATLAS = 'data:image/png;base64,${cornerPng.toString('base64')}'
`)
  console.log(`${cells.length} glyphs (${png.length} bytes), ${corners.length} corners (${cornerPng.length} bytes)`)
}
