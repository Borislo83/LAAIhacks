// Generates src/spinner-frames.ts: the loading spinner as pre-rendered
// greyscale PNG frames: a bright arc with a tail that fades to black. There is
// no background ring: dim greys glow brighter than expected on the lens, which
// made a faint ring read as solid and hid the motion.
// Run: npx tsx scripts/gen-spinner.mts
import sharp from 'sharp'
import { writeFileSync } from 'node:fs'

const SIZE = 48
const FRAMES = 12
const STROKE = 5
const R = SIZE / 2 - STROKE / 2 - 1
const SEGMENTS = 36
/** Share of the ring the bright arc and its tail cover. */
const ARC = 0.7

function svg(frame: number) {
  const c = SIZE / 2
  const start = (frame / FRAMES) * 2 * Math.PI
  const pt = (a: number) => `${(c + R * Math.sin(a)).toFixed(2)} ${(c - R * Math.cos(a)).toFixed(2)}`
  const segs: string[] = []
  const n = Math.round(SEGMENTS * ARC)
  for (let i = 0; i < n; i++) {
    // Head at `start`, tail fading backwards (counter-clockwise).
    const a1 = start - (i / SEGMENTS) * 2 * Math.PI
    const a0 = start - ((i + 1.15) / SEGMENTS) * 2 * Math.PI
    const level = Math.round(255 * Math.pow(1 - i / n, 1.6))
    segs.push(`<path d="M ${pt(a0)} A ${R} ${R} 0 0 1 ${pt(a1)}" stroke="rgb(${level},${level},${level})" />`)
  }
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${SIZE}" height="${SIZE}">
  <rect width="100%" height="100%" fill="black"/>
  <g fill="none" stroke-width="${STROKE}" stroke-linecap="butt">${segs.join('')}</g>
  <circle cx="${pt(start).split(' ')[0]}" cy="${pt(start).split(' ')[1]}" r="${STROKE / 2}" fill="white"/>
</svg>`
}

const frames: string[] = []
for (let f = 0; f < FRAMES; f++) {
  const png = await sharp(Buffer.from(svg(f)))
    .greyscale()
    .png({ compressionLevel: 9, palette: true, colours: 16 })
    .toBuffer()
  frames.push(png.toString('base64'))
}
writeFileSync(
  new URL('../src/spinner-frames.ts', import.meta.url),
  `// Generated by scripts/gen-spinner.mts — do not edit.\nexport const SPINNER_SIZE = ${SIZE}\nexport const SPINNER_FRAMES = ${JSON.stringify(frames, null, 1)}\n`,
)
console.log(`${FRAMES} frames, ${frames.map(f => Math.round((f.length * 3) / 4)).join('/')} bytes`)
