{
  "name": "glasses-web-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:server\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "evenhub-simulator http://localhost:5173",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:preview": "node tests/preview-server.mjs",
    "qr": "bash scripts/qr.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.13.13",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "qr-image": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
