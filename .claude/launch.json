{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/dashboard/prototype"
      ],
      "port": 5173
    },
    {
      "name": "agents",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/agents",
        "laai-agents"
      ],
      "port": 8000
    },
    {
      "name": "orchestrator",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/orchestrator",
        "laai-orchestrator"
      ],
      "port": 8001
    },
    {
      "name": "glasses-condense",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "glasses-web-reader",
        "run",
        "server"
      ],
      "port": 8787,
      "env": {
        "ORCHESTRATOR_ALLOWED_ORIGINS": "http://localhost:5180,http://127.0.0.1:5180"
      },
      "autoPort": false
    },
    {
      "name": "glasses-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "glasses-web-reader",
        "run",
        "dev"
      ],
      "env": {
        "VITE_PORT": "5180",
        "ORCHESTRATOR_ALLOWED_ORIGINS": "http://localhost:5180,http://127.0.0.1:5180,http://172.26.73.253:5180",
        "CONDENSE_PORT": "8797",
        "GATEWAY_DEV_TOKEN": "demo-all"
      },
      "port": 5180,
      "autoPort": false
    }
  ]
}
