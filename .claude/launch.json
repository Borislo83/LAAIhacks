{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/dashboard/prototype"
      ],
      "port": 5173
    },
    {
      "name": "agents",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/agents",
        "laai-agents"
      ],
      "port": 8000
    },
    {
      "name": "orchestrator",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/orchestrator",
        "laai-orchestrator"
      ],
      "port": 8001
    },
    {
      "name": "glasses-condense",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "glasses-web-reader",
        "run",
        "server"
      ],
      "port": 8787
    }
  ]
}
