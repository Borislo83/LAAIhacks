SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend only. Never expose this key to the dashboard or glasses.
SUPABASE_SECRET_KEY=sb_secret_...
AGENTS_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000"]
# Optional: ASI:One understands page text and predicts tasks. Without a key,
# send an explicit product field to get deterministic shopping suggestions.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# Keep authentication enabled for the dashboard.
CHAT_AUTH_REQUIRED=true
AMAZON_CART_EXECUTOR_TOKEN=
# Backend only. Lets signed-in users send iMessage drafts they confirmed; empty disables sending.
IMESSAGE_EXECUTOR_TOKEN=
# Backend only. Opens "play X" YouTube videos in the laptop's browser; same value as in
# services/agents/.env. Empty: chat only returns the link.
LAPTOP_EXECUTOR_TOKEN=
# Backend only. Controls Spotify on the laptop; same value as in services/agents/.env.
# Empty: Spotify requests are refused.
SPOTIFY_EXECUTOR_TOKEN=

# Local development only: accept the fixture tokens demo-web, demo-g2, demo-agent,
# demo-executor and demo-all from this machine, all acting as DEMO_USER_ID (an existing
# Supabase Auth user ID). Never enable on a hosted deployment.
DEMO_AUTH_MODE=false
DEMO_USER_ID=
