SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend only. Never expose this key to the dashboard or glasses.
SUPABASE_SECRET_KEY=sb_secret_...
AGENTS_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000"]
# Optional: ASI:One understands page text and predicts tasks. Without a key,
# send an explicit product field to get deterministic shopping suggestions.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# Keep authentication enabled for the dashboard.
CHAT_AUTH_REQUIRED=true
AMAZON_CART_EXECUTOR_TOKEN=
