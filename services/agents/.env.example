# Get a key at https://asi1.ai (Developer section > Create New). Optional: without it the
# agents still work, they just skip LLM summaries and product-name extraction.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# Seeds fix each agent's address. Change these before deploying anywhere public.
PRICE_AGENT_SEED=laai price compare agent dev seed
ALTERNATIVES_AGENT_SEED=laai alternatives agent dev seed
REVIEWS_AGENT_SEED=laai reviews agent dev seed

# 1 = connect through an Agentverse mailbox (needed for ASI:One to reach a local agent)
AGENTVERSE_MAILBOX=0

# Live sources by default. demo is explicit fixture mode, never a fallback.
PRODUCT_DATA_MODE=live
# auto tries ASI search + snippets, then keyless DDGS; ddgs uses free search directly.
SEARCH_PROVIDER=ddgs
COORDINATOR_AGENT_SEED=replace-with-a-private-coordinator-seed
COORDINATOR_AGENTVERSE_MAILBOX=0

# Glasses Team's contract v1.0 API; set these to integrate approval events.
GLASSES_API_URL=
GLASSES_WEB_TOKEN=
GLASSES_AGENT_TOKEN=
GLASSES_EXECUTOR_TOKEN=
