# Get a key at https://asi1.ai (Developer section > Create New). Optional: without it the
# agents still work, they just skip LLM summaries and product-name extraction.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# Seeds fix each agent's address. Change these before deploying anywhere public.
PRICE_AGENT_SEED=laai price compare agent dev seed
ALTERNATIVES_AGENT_SEED=laai alternatives agent dev seed
REVIEWS_AGENT_SEED=laai reviews agent dev seed
YOUTUBE_AGENT_SEED=laai youtube agent dev seed
MESSENGER_AGENT_SEED=laai messenger agent dev seed
# Optional: YouTube Data API key. Without it the YouTube agent uses keyless search.
YOUTUBE_API_KEY=
# Spotify agent: client ID of an app at https://developer.spotify.com/dashboard with
# redirect URI http://127.0.0.1:8888/callback. Then run `uv run laai-spotify-login` once.
SPOTIFY_AGENT_SEED=laai spotify agent dev seed
SPOTIFY_CLIENT_ID=
# Optional: the laptop's Spotify device name; default is the first "Computer" device.
SPOTIFY_DEVICE_NAME=

# 1 = connect through an Agentverse mailbox (needed for ASI:One to reach a local agent)
AGENTVERSE_MAILBOX=0

# Live sources by default. demo is explicit fixture mode, never a fallback.
PRODUCT_DATA_MODE=live
# auto tries ASI search + snippets, then keyless DDGS; ddgs uses free search directly.
SEARCH_PROVIDER=ddgs
COORDINATOR_AGENT_SEED=replace-with-a-private-coordinator-seed
COORDINATOR_AGENTVERSE_MAILBOX=0
BUYER_AGENT_SEED=replace-with-a-private-demo-buyer-seed
# Shared backend-only secret for the real Amazon cart browser executor.
AMAZON_CART_EXECUTOR_TOKEN=
# Optional dedicated Chrome profile; never point this at your normal Chrome profile.
AMAZON_BROWSER_PROFILE=.runtime/amazon-profile

# Glasses Team's contract v1.0 API; set these to integrate approval events.
GLASSES_API_URL=
GLASSES_WEB_TOKEN=
GLASSES_AGENT_TOKEN=
GLASSES_EXECUTOR_TOKEN=

# Store data for real products, prices and cart links (both optional).
# Free key: https://developer.bestbuy.com
BESTBUY_API_KEY=
# Amazon + Google Shopping listings: https://serpapi.com
SERPAPI_API_KEY=

# iMessage agent (macOS only). Friends it may message: Name=+15551234567,Name=a@icloud.com
IMESSAGE_CONTACTS=
# Private token the orchestrator sends to /imessage/send; never send it to the browser.
IMESSAGE_EXECUTOR_TOKEN=
# 1 (the default when unset) records sends without running osascript. 0 sends for real.
IMESSAGE_DRY_RUN=1
# Private token the orchestrator sends to /youtube/open to play a video in the laptop's
# browser; same value as in services/orchestrator/.env. Empty disables opening.
LAPTOP_EXECUTOR_TOKEN=
# 1 answers dry_run without opening anything. Unset or 0 opens for real (macOS only).
LAPTOP_OPEN_DRY_RUN=0

# ASI:One demo flow (coordinator). New agents: verifier and memory.
VERIFIER_AGENT_SEED=laai price verifier dev seed
MEMORY_AGENT_SEED=laai memory agent dev seed
# Comma-separated ASI:One sender addresses allowed to run the real cart/iMessage steps.
# Everyone else gets the same flow with those two steps clearly simulated.
FOCAL_OWNER_ADDRESSES=
# Contact name from IMESSAGE_CONTACTS to tell about a purchase; empty skips that step.
FOCAL_SHARE_CONTACT=
# Seconds between price-watch checks (minimum 60).
FOCAL_WATCH_SECONDS=300
# Memory agent: read-only Focal Studio preferences from Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FOCAL_MEMORY_USER_ID=
# Payment Protocol for the paid price watch. Use Stripe *test* keys: no real money moves.
# Live keys are refused unless FOCAL_ALLOW_LIVE_PAYMENTS=1.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
FOCAL_WATCH_PRICE_CENTS=99
# For `uv run laai-register`: agentverse.ai → Profile → API Keys. Registers every agent's mailbox.
AGENTVERSE_API_KEY=
NEWS_AGENT_SEED=laai news agent dev seed
